// ===============================================
// PRISMA SCHEMA — GOENAKAN ID (UPDATED)
// ===============================================
// CHANGELOG:
// - Tambah indexes di tabel yang sering di-query analytics
// - Tambah targetEndDate di ProductionTracker (untuk late delivery)
// - Tambah uuid kolom di Invoice (dual ID, non-breaking)
// - Tambah flag isMarketing di FinanceCategory (untuk CAC)
// - Tambah snapshot fields di OrderProduct (historical accuracy)
// - Drop kolom 'currency' (String) di CashflowRevenue/Cost - pakai FK saja
// - Fix typo: lowercase 'currency' relation field
// ===============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
}

// ===============================================
// ENUMS & MASTER TABLES
// ===============================================
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  FOLLOW_UP
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WebOrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  ADMIN_ARTICLE
  ADMIN_INVOICE
  CUSTOMER
}

enum AccountType {
  INDIVIDUAL
  CORPORATE
}

enum ClientType {
  B2B
  B2C
}

enum VendorType {
  SERVICE
  PRODUCT
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceCategory {
  DP
  FULL_PAYMENT
  INSTALLMENT
  REMAINING_BALANCE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  QRIS
}

enum SalesCategory {
  SALES
  SAMPLE
}

enum CashflowType {
  IN
  OUT
}

enum InOutType {
  INBOUND
  OUTBOUND
}

enum DeliveryType {
  FULL
  PARTIAL
}

enum DeliveryStatus {
  SENT
  PENDING
  CANCELLED
}

enum ProductionStatus {
  PENDING
  IN_PRODUCTION
  COMPLETED
}

enum ShipmentType {
  INBOUND
  OUTBOUND
}

enum ShipmentStatus {
  PENDING
  PREPARED
  DISPATCHED
  ARRIVED
  CANCELLED
}

enum ShippingMethod {
  LAND
  SEA
  AIR
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ===============================================
// USER TABLE
// ===============================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(CUSTOMER)

  createdAt DateTime @default(now())

  articles            Article[]
  invoices            Invoice[]
  sessions            Session[]
  financeTransactions FinanceTransaction[]
  customerProfile     CustomerProfile?
  accounts            Account[]
  client              Client?

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===============================================
// CLIENT SECTION
// ===============================================
model PurchaseChannel {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientsB2B ClientB2B[]
  clientsB2C ClientB2C[]
  orders     Order[]

  @@map("purchase_channels")
}

model Client {
  id        String     @id @default(uuid())
  custCode  String     @unique
  type      ClientType
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  b2b        ClientB2B?
  b2c        ClientB2C?
  orders     Order[]
  invoices   Invoice[]
  quotations Quotation[]

  @@index([type])
  @@map("clients")
}

model ClientB2C {
  id     String  @id
  prefix String
  name   String
  phone  String?

  country     String?
  province    String?
  city        String?
  district    String?
  subDistrict String?
  postalCode  String?
  fullAddress String

  purchaseChannelId String
  purchaseChannel   PurchaseChannel @relation(fields: [purchaseChannelId], references: [id])

  client Client @relation(fields: [id], references: [id])

  @@index([purchaseChannelId])
  @@index([city])
  @@index([province])
  @@map("clients_b2c")
}

model ClientB2B {
  id           String     @id
  companyName  String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  phone   String?
  email   String?
  // CATATAN: website tetap non-nullable. Kalau perlu diubah, lakukan migration terpisah.
  website String

  country     String?
  province    String?
  city        String?
  district    String?
  subDistrict String?
  postalCode  String?
  fullAddress String

  purchaseChannelId String
  purchaseChannel   PurchaseChannel @relation(fields: [purchaseChannelId], references: [id])

  pics   ClientB2BPIC[]
  client Client         @relation(fields: [id], references: [id])

  @@index([departmentId])
  @@index([purchaseChannelId])
  @@index([city])
  @@index([province])
  @@map("clients_b2b")
}

model ClientB2BPIC {
  id          String  @id @default(uuid())
  clientB2BId String
  prefix      String?
  name        String
  email       String?
  phone       String?

  clientB2B  ClientB2B   @relation(fields: [clientB2BId], references: [id])
  orders     Order[]
  quotations Quotation[]

  @@index([clientB2BId])
  @@map("client_b2b_pics")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientsB2B ClientB2B[]

  @@map("departments")
}

// ===============================================
// PRODUCT SECTION
// ===============================================

model ProductCategory {
  id             String         @id @default(uuid())
  slug           String         @unique
  name_id        String         @unique @map("name")
  description_id String?        @map("description") @db.Text
  name_en        String?
  description_en String?        @db.Text
  image          String?
  imageId        String?
  code           String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       Product[]
  itemCategories ItemCategory[]

  @@map("product_categories")
}

model ItemCategory {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  code              String          @unique
  description       String?         @db.Text
  productCategoryId String
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  itemNames         ItemName[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  products          Product[]

  @@index([productCategoryId])
  @@map("item_categories")
}

model ItemName {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  code           String       @unique
  description    String?      @db.Text
  itemCategoryId String
  itemCategory   ItemCategory @relation(fields: [itemCategoryId], references: [id])
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([itemCategoryId])
  @@map("item_names")
}

model Product {
  id              String                  @id @default(uuid())
  name            String
  sku             String                  @unique
  slug            String                  @unique
  description     String?                 @db.Text
  basePrice       Decimal
  isCustom        Boolean                 @default(false)
  materialTypeId  String?
  materialType    MaterialType?           @relation(fields: [materialTypeId], references: [id])
  stock           Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  weight          Float?
  width           Float?
  height          Float?
  length          Float?
  categoryId      String
  category        ProductCategory         @relation(fields: [categoryId], references: [id])
  itemCategoryId  String?
  itemCategory    ItemCategory?           @relation(fields: [itemCategoryId], references: [id])
  itemNameId      String?
  itemName        ItemName?               @relation(fields: [itemNameId], references: [id])
  attributeValues ProductAttributeValue[]
  priceTiers      PriceTier[]
  tags            Tag[]
  invoiceItems    InvoiceItem[]
  orderProducts   OrderProduct[]
  quotationItems  QuotationItem[]
  cashflowRevenue CashflowRevenue[]
  images          ProductImage[]
  videos          ProductVideo[]
  productVariants ProductVariant[]
  seo             ProductSEO?
  articleProducts ArticleProduct[]
  cartItems       CartItem[]
  webOrderItems   WebOrderItem[]

  @@index([categoryId])
  @@index([itemCategoryId])
  @@index([itemNameId])
  @@index([materialTypeId])
  @@map("products")
}

model MaterialType {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  code        String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("material_types")
}

model ProductSEO {
  id              String  @id @default(uuid())
  metaTitle       String?
  metaDescription String?
  keywords        String?
  canonicalUrl    String?

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  structuredData String? @db.Text
  productId      String  @unique
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_seo")
}

model Attribute {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values   AttributeValue[]
  products ProductAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(uuid())
  value       String
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])

  products                      ProductAttributeValue[]
  productVariantAttributeValues ProductVariantAttributeValue[]

  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttributeValue {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])
  attribute        Attribute?     @relation(fields: [attributeId], references: [id])
  attributeId      String?

  @@unique([productId, attributeValueId])
  @@index([attributeValueId])
  @@index([attributeId])
  @@map("product_attribute_values")
}

model ProductVariant {
  id          String   @id @default(uuid())
  sku         String   @unique
  stock       Int      @default(0)
  variantName String?
  price       Decimal?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weight Float?
  width  Float?
  height Float?
  length Float?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  attributeValues ProductVariantAttributeValue[]
  images          ProductVariantImage[]
  orderProducts   OrderProduct[]
  invoiceItems    InvoiceItem[]
  quotationItems  QuotationItem[]
  cartItems       CartItem[]
  webOrderItems   WebOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantAttributeValue {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_variant_attribute_values")
}

model PriceTier {
  id          String   @id @default(uuid())
  minQuantity Int      @default(1)
  maxQuantity Int?
  price       Decimal
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([productId])
  @@map("price_tiers")
}

model ProductVariantImage {
  id         String   @id @default(uuid())
  url        String
  publicId   String
  isFeatured Boolean? @default(false)
  altText    String?

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@map("product_variant_images")
}

model ProductImage {
  id         String  @id @default(uuid())
  url        String
  publicId   String
  isFeatured Boolean @default(false)
  altText    String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id         String  @id @default(uuid())
  url        String
  publicId   String
  title      String?
  isFeatured Boolean @default(false)
  altText    String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_videos")
}

// ===============================================
// INVOICE SECTION
// ===============================================

model Invoice {
  id            Int             @id @default(autoincrement())
  uuid          String?         @unique @default(uuid())
  invoiceNumber String?         @unique
  clientId      String
  userId        String
  orderId       String?
  totalAmount   Decimal
  status        InvoiceStatus   @default(UNPAID)
  category      InvoiceCategory @default(FULL_PAYMENT)
  method        PaymentMethod?
  dueDate       DateTime?
  paymentDate   DateTime?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id])
  client Client        @relation(fields: [clientId], references: [id])
  order  Order?        @relation(fields: [orderId], references: [id])
  items  InvoiceItem[]
  notes  InvoiceNote[]

  @@index([clientId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  productId     String
  variantId     String?
  remarks       String?
  customization Json?

  quantity Int
  price    Decimal

  invoice Invoice         @relation(fields: [invoiceId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([variantId])
  @@map("invoice_items")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("tags")
}

// ===============================================
// INVOICE NOTE SECTION
// ===============================================

model NoteCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates    NoteTemplate[]
  invoiceNotes InvoiceNote[]

  @@map("note_categories")
}

model NoteTemplate {
  id         String   @id @default(uuid())
  categoryId String
  title      String
  content    String   @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category NoteCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("note_templates")
}

model InvoiceNote {
  id         String @id @default(uuid())
  invoiceId  Int
  categoryId String
  content    String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice  Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category NoteCategory @relation(fields: [categoryId], references: [id])

  @@index([invoiceId])
  @@index([categoryId])
  @@map("invoice_notes")
}

// ===============================================
// VENDOR SECTION
// ===============================================

model Vendor {
  id          String   @id @default(uuid())
  companyName String
  slug        String   @unique
  picName     String
  country     String?
  province    String?
  city        String?
  district    String?
  subDistrict String?
  postalCode  String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  trackingUrl String?  @db.Text

  vendorItems    VendorVendorItem[]
  cashflowCost   CashflowCost[]
  orderVendors   OrderVendor[]
  contacts       VendorContact[]
  productionJobs ProductionTracker[]
  shipments      Shipment[]

  @@index([isActive])
  @@map("vendors")
}

model VendorCategory {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  type        VendorType
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isActive    Boolean      @default(true)
  items       VendorItem[]

  @@map("vendor_categories")
}

model VendorItem {
  id          String             @id @default(uuid())
  categoryId  String
  slug        String             @unique
  name        String
  description String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  category    VendorCategory     @relation(fields: [categoryId], references: [id])
  vendors     VendorVendorItem[]

  @@index([categoryId])
  @@map("vendor_items")
}

model VendorVendorItem {
  vendorId String
  itemId   String
  vendor   Vendor     @relation(fields: [vendorId], references: [id])
  item     VendorItem @relation(fields: [itemId], references: [id])

  @@id([vendorId, itemId])
  @@index([itemId])
  @@map("vendor_vendor_items")
}

// ===============================================
// CONTACT SECTION
// ===============================================

model VendorContact {
  id         String   @id @default(uuid())
  vendorId   String
  platformId String
  contactId  String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor   Vendor          @relation(fields: [vendorId], references: [id])
  platform ContactPlatform @relation(fields: [platformId], references: [id])

  @@index([vendorId])
  @@index([platformId])
  @@map("vendor_contacts")
}

model ContactPlatform {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  icon      String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  contacts  VendorContact[]

  @@map("contact_platforms")
}

// ===============================================
// SALES SECTION
// ===============================================

model Sales {
  id                  String               @id @default(uuid())
  prefix              String
  name                String
  phone               String
  signatureUrl        String?
  signaturePublicId   String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  bankAccounts        SalesBank[]
  financeTransactions FinanceTransaction[]
  quotations          Quotation[]

  @@index([isActive])
  @@map("sales")
}

model SalesBank {
  salesId           String
  bankName          String
  accountNumber     String
  accountHolderName String

  sales Sales @relation(fields: [salesId], references: [id])

  @@id([salesId, accountNumber])
  @@map("sales_banks")
}

// ===============================================
// ORDER SYSTEM
// ===============================================

model Order {
  id                 String                @id @default(uuid())
  orderNumber        String?               @unique
  dateOrder          DateTime
  salesCategory      SalesCategory
  poNumber           String?
  clientId           String
  salesId            String?
  shippingAddress    String
  totalAmount        Decimal
  status             OrderStatus           @default(PENDING)
  webOrderId         String?               @unique
  webOrder           WebOrder?             @relation(fields: [webOrderId], references: [id])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  clientB2BPICId     String?
  pic                ClientB2BPIC?         @relation(fields: [clientB2BPICId], references: [id])
  purchaseChannelId  String?
  purchaseChannel    PurchaseChannel?      @relation(fields: [purchaseChannelId], references: [id])
  client             Client                @relation(fields: [clientId], references: [id])
  sales              Sales?                @relation(fields: [salesId], references: [id])
  products           OrderProduct[]
  vendors            OrderVendor[]
  cashflows          Cashflow[]
  productionTrackers ProductionTracker[]
  shipments          Shipment[]
  invoices           Invoice[]
  deliveryNotes      DeliveryNote[]
  quotations         Quotation[]
  cashflowSummary    CashflowSummary[]
  sampleFollowUps    OrderSampleFollowUp[]

  // === INDEXES UNTUK ANALYTICS ===
  @@index([dateOrder])
  @@index([status])
  @@index([dateOrder, status])
  @@index([clientId])
  @@index([clientId, status])
  @@index([salesCategory])
  @@index([salesCategory, status])
  @@index([salesId])
  @@index([purchaseChannelId])
  @@index([clientB2BPICId])
  @@map("orders")
}

model OrderProduct {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  quantity      Int
  unitPrice     Decimal
  customization Json?
  remarks       String?

  // === SNAPSHOT FIELDS (untuk historical accuracy jika product diubah/dihapus) ===
  productNameSnapshot String?
  skuSnapshot         String?

  order              Order               @relation(fields: [orderId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])
  productionTrackers ProductionTracker[]
  shipmentItems      ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_products")
}

model OrderVendor {
  id             String @id @default(uuid())
  orderId        String
  vendorId       String
  vendorPicName  String
  vendorPicPhone String
  roleInOrder    String
  order          Order  @relation(fields: [orderId], references: [id])
  vendor         Vendor @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@map("order_vendors")
}

model OrderSampleFollowUp {
  id      String   @id @default(uuid())
  orderId String
  date    DateTime @default(now())

  name       String?
  method     String?
  notes      String? @db.Text
  nextAction String?

  isDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([date])
  @@index([isDone])
  @@map("order_sample_follow_ups")
}

// ===============================================
// CASHFLOW SECTION
// ===============================================

model Cashflow {
  id          String       @id @default(uuid())
  orderId     String
  description String
  amount      Decimal
  type        CashflowType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([type])
  @@map("cashflows")
}

// ===============================================
// PRODUCTION TRACKING
// ===============================================

model ProductionTracker {
  id             String           @id @default(uuid())
  orderId        String
  orderProductId String
  vendorId       String
  step           Int              @default(1)
  quantity       Int
  startDate      DateTime?
  // === FIELD BARU untuk LATE DELIVERY detection ===
  // Target tanggal selesai produksi yang dijanjikan ke client/vendor.
  // Jika endDate > targetEndDate, dianggap LATE.
  targetEndDate  DateTime?
  endDate        DateTime?
  status         ProductionStatus @default(PENDING)
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order        @relation(fields: [orderId], references: [id])
  orderProduct OrderProduct @relation(fields: [orderProductId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([orderProductId])
  @@index([vendorId])
  @@index([status])
  @@index([endDate])
  @@index([targetEndDate])
  @@map("production_trackers")
}

// ===============================================
// LOGISTICS / SHIPMENT SYSTEM
// ===============================================

model Shipment {
  id                 String            @id @default(uuid())
  orderId            String
  vendorId           String?
  deliveryNoteNumber String?
  trackingNumber     String?
  courierLink        String?
  step               Int               @default(1)
  type               ShipmentType
  method             ShippingMethod
  status             ShipmentStatus    @default(PREPARED)
  history            ShipmentHistory[]
  origin             String?
  destination        String?
  departureDate      DateTime?
  arrivalDate        DateTime?
  // === FIELD BARU: target tanggal sampai (untuk SLA shipping) ===
  targetArrivalDate  DateTime?

  notes ShipmentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order          @relation(fields: [orderId], references: [id])
  vendor Vendor?        @relation(fields: [vendorId], references: [id])
  items  ShipmentItem[]

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@index([arrivalDate])
  @@index([departureDate])
  @@map("shipments")
}

model ShipmentHistory {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  city       String?
  date       DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([date])
}

model ShipmentItem {
  id             String @id @default(uuid())
  shipmentId     String
  orderProductId String
  totalCarton    Int?   @default(0)
  quantity       Int

  shipment     Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderProduct OrderProduct @relation(fields: [orderProductId], references: [id])

  @@index([shipmentId])
  @@index([orderProductId])
  @@map("shipment_items")
}

model ShipmentNoteCategory {
  id        String   @id @default(uuid())
  name      String
  templates Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes ShipmentNote[]

  @@map("shipment_note_categories")
}

model ShipmentNote {
  id         String @id @default(uuid())
  shipmentId String
  categoryId String
  content    String @db.Text

  createdAt DateTime @default(now())

  shipment Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  category ShipmentNoteCategory @relation(fields: [categoryId], references: [id])

  @@index([shipmentId])
  @@index([categoryId])
  @@map("shipment_notes")
}

model DeliveryNote {
  id             String         @id @default(uuid())
  orderId        String
  deliveryNumber String         @unique
  deliveryDate   DateTime
  type           DeliveryType
  status         DeliveryStatus
  remarks        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([deliveryDate])
  @@map("delivery_notes")
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String?         @unique
  date            DateTime        @default(now())
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)

  clientId String?
  client   Client?       @relation(fields: [clientId], references: [id])
  picId    String?
  pic      ClientB2BPIC? @relation(fields: [picId], references: [id])

  manualClientName    String?
  manualClientCompany String?
  manualClientEmail   String?
  manualClientPhone   String?
  manualClientAddress String? @db.Text

  subTotal       Decimal  @default(0)
  taxAmount      Decimal? @default(0)
  discountAmount Decimal? @default(0)
  totalAmount    Decimal  @default(0)

  // === FIELD BARU: tanggal saat status berubah jadi ACCEPTED (untuk lead time akurat) ===
  acceptedAt DateTime?

  notes QuotationNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id])
  salesId   String?
  sales     Sales?              @relation(fields: [salesId], references: [id])
  items     QuotationItem[]
  followUps QuotationFollowUp[]

  @@index([clientId])
  @@index([picId])
  @@index([salesId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([acceptedAt])
  @@map("quotations")
}

model QuotationNoteCategory {
  id        String @id @default(uuid())
  name      String
  templates Json?

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes QuotationNote[]

  @@map("quotation_note_categories")
}

model QuotationNote {
  id          String @id @default(cuid())
  quotationId String
  categoryId  String
  content     String @db.Text

  createdAt DateTime @default(now())

  quotation Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  category  QuotationNoteCategory @relation(fields: [categoryId], references: [id])

  @@index([quotationId])
  @@index([categoryId])
  @@map("quotation_notes")
}

model QuotationFollowUp {
  id          String   @id @default(cuid())
  quotationId String
  date        DateTime @default(now())
  name        String?
  method      String?
  notes       String?  @db.Text
  nextAction  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([date])
  @@map("quotation_follow_ups")
}

model QuotationItem {
  id            String              @id @default(cuid())
  quotationId   String
  productId     String?
  product       Product?            @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant?     @relation(fields: [variantId], references: [id])
  productName   String
  description   String?             @db.Text
  customization Json?
  discount      Decimal?            @default(0)
  remarks       String?
  imageUrl      String?
  imagePublicId String?
  quotation     Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  tiers         QuotationItemTier[]

  @@index([quotationId])
  @@index([productId])
  @@index([variantId])
  @@map("quotation_items")
}

model QuotationItemTier {
  id              String        @id @default(cuid())
  quotationItemId String
  minQuantity     Int
  maxQuantity     Int?
  quantityLabel   String?
  unitPrice       Decimal
  totalPrice      Decimal
  item            QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@index([quotationItemId])
  @@map("quotation_item_tiers")
}

model CashflowSummary {
  id             String   @id @default(uuid())
  orderId        String
  poNumber       String
  totalRevenue   Decimal
  totalCost      Decimal
  profitLoss     Decimal
  baseCurrencyId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        Order             @relation(fields: [orderId], references: [id])
  baseCurrency Currency          @relation(fields: [baseCurrencyId], references: [code])
  revenues     CashflowRevenue[]
  costs        CashflowCost[]

  @@index([orderId])
  @@index([baseCurrencyId])
  @@map("cashflow_summaries")
}

model CashflowRevenue {
  id           String   @id @default(uuid())
  cashflowId   String
  description  String
  productId    String?
  unitPrice    Decimal
  quantity     Int
  total        Decimal
  // CATATAN: kolom 'currency' String dihapus. Pakai FK currencyCode saja.
  exchangeRate Decimal?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  summary      CashflowSummary @relation(fields: [cashflowId], references: [id])
  product      Product?        @relation(fields: [productId], references: [id])
  // Fix: lowercase relation field name (consistency)
  currency     Currency?       @relation(fields: [currencyCode], references: [code])
  currencyCode String?

  @@index([cashflowId])
  @@index([productId])
  @@index([currencyCode])
  @@map("cashflow_revenue")
}

model CashflowCost {
  id           String   @id @default(uuid())
  cashflowId   String
  description  String
  vendorId     String?
  costPerUnit  Decimal
  quantity     Int
  total        Decimal
  // CATATAN: kolom 'currency' String dihapus. Pakai FK currencyCode saja.
  exchangeRate Decimal?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  summary      CashflowSummary @relation(fields: [cashflowId], references: [id])
  vendor       Vendor?         @relation(fields: [vendorId], references: [id])
  currency     Currency?       @relation(fields: [currencyCode], references: [code])
  currencyCode String?

  @@index([cashflowId])
  @@index([vendorId])
  @@index([currencyCode])
  @@map("cashflow_cost")
}

// ===============================================
// CURRENCY MASTER
// ===============================================

model Currency {
  code   String @id
  symbol String
  name   String

  cashflowSummaries CashflowSummary[]
  cashflowRevenues  CashflowRevenue[]
  cashflowCosts     CashflowCost[]

  @@map("currencies")
}

// ===============================================
// WEBSITE CONTENT: FAQ SECTION
// ===============================================

model FaqCategory {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faqs Faq[]

  @@map("faq_categories")
}

model Faq {
  id           String   @id @default(uuid())
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("faqs")
}

model HeroSlide {
  id    String @id @default(uuid())
  title String

  imageUrl      String
  imagePublicId String

  altText      String?  @db.Text
  ctaText      String?
  ctaLink      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hero_slides")
}

model PopupBanner {
  id                   String @id @default(uuid())
  title                String
  desktopImageUrl      String
  desktopImagePublicId String

  mobileImageUrl      String
  mobileImagePublicId String

  altText String?
  linkUrl String?

  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("popup_banners")
}

model ClientLogo {
  id   String @id @default(uuid())
  name String

  imageUrl      String
  imagePublicId String

  altText    String?
  websiteUrl String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_logos")
}

model AppSetting {
  id          String  @id @default(uuid())
  googleAdsId String?
  gtmId       String?
  pixelId     String?

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model FinanceCategory {
  id          String          @id @default(uuid())
  name        String          @unique
  slug        String          @unique
  type        TransactionType
  description String?
  isActive    Boolean         @default(true)
  // === FLAG BARU untuk CAC calculation ===
  // Tandai kategori yang termasuk biaya marketing/akuisisi pelanggan.
  isMarketing Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transactions FinanceTransaction[]

  @@index([type])
  @@index([isMarketing])
  @@map("finance_categories")
}

model FinanceTransaction {
  id              String          @id @default(uuid())
  transactionDate DateTime        @default(now())
  type            TransactionType
  amount          Decimal         @default(0)
  referenceNumber String?
  description     String          @db.Text

  method PaymentMethod?

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  categoryId String
  category   FinanceCategory @relation(fields: [categoryId], references: [id])

  salesId String?
  sales   Sales?  @relation(fields: [salesId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionDate])
  @@index([type])
  @@index([type, transactionDate])
  @@index([categoryId])
  @@index([salesId])
  @@index([createdBy])
  @@map("finance_transactions")
}

// ===============================================
// WEBSITE CLIENT SECTION (B2C & E-Commerce B2B)
// ===============================================

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  accountType AccountType @default(INDIVIDUAL)

  phone String?

  picName     String?
  picPhone    String?
  companyName String?
  department  String?

  avatarUrl String?
  addresses CustomerAddress[]
  carts     Cart[]
  orders    WebOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountType])
  @@map("customer_profiles")
}

model Cart {
  id        String          @id @default(uuid())
  profileId String          @unique
  profile   CustomerProfile @relation(fields: [profileId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int

  customization Json?
  notes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model CustomerAddress {
  id          String          @id @default(uuid())
  profileId   String
  profile     CustomerProfile @relation(fields: [profileId], references: [id])
  label       String
  recipient   String
  phone       String
  country     String?
  province    String?
  city        String?
  district    String?
  postalCode  String?
  fullAddress String          @db.Text
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([profileId])
  @@map("customer_addresses")
}

model WebOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  profileId       String?
  profile         CustomerProfile? @relation(fields: [profileId], references: [id])
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  shippingAddress Json
  subtotal        Decimal
  shippingCost    Decimal
  customerNote    String?          @db.Text
  taxAmount       Decimal?         @default(0)
  totalAmount     Decimal
  status          WebOrderStatus   @default(PENDING_PAYMENT)
  canceledReason  String?          @db.Text
  paymentMethod   String?
  paymentUrl      String?
  items           WebOrderItem[]
  order           Order?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([profileId])
  @@index([status])
  @@index([createdAt])
  @@map("web_orders")
}

model WebOrderItem {
  id          String          @id @default(uuid())
  webOrderId  String
  webOrder    WebOrder        @relation(fields: [webOrderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  quantity    Int
  price       Decimal
  total       Decimal

  customization Json?
  notes         String?

  @@index([webOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("web_order_items")
}

// ===============================================
// ARTICLE SECTION
// ===============================================

model ArticleCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@map("article_categories")
}

model Article {
  id                 String    @id @default(uuid())
  title              String    @db.VarChar(255)
  slug               String    @unique
  content            String    @db.LongText
  coverImage         String
  coverImageId       String?
  coverImageAlt      String?
  coverImageMobile   String?
  coverImageMobileId String?
  focusKeywords      String?   @db.Text
  source             String?   @db.Text
  published          Boolean   @default(false)
  publishedAt        DateTime?
  authorName         String?   @db.VarChar(100)
  authorId           String
  author             User      @relation(fields: [authorId], references: [id])

  categoryId      String
  category        ArticleCategory  @relation(fields: [categoryId], references: [id])
  articleTags     ArticleTagMap[]
  relatedProducts ArticleProduct[]
  articleBanners  ArticleBanner[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  seo             ArticleSEO?

  @@index([authorId])
  @@index([categoryId])
  @@index([published])
  @@index([publishedAt])
  @@map("articles")
}

model ArticleProduct {
  articleId String
  productId String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
  @@map("article_products")
}

model ArticleBanner {
  id              String  @id @default(uuid())
  backgroundColor String  @db.VarChar(50)
  buttonText      String  @db.VarChar(100)
  ctaLink         String  @db.Text
  isActive        Boolean @default(false)

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@map("article_banners")
}

model ArticleTag {
  id        String          @id @default(uuid())
  name      String          @unique
  slug      String          @unique
  createdAt DateTime        @default(now())
  articles  ArticleTagMap[]

  @@map("article_tags")
}

model ArticleTagMap {
  articleId  String
  tagId      String
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleTag ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tag_pivot")
}

model ArticleSEO {
  id              String  @id @default(cuid())
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.Text
  keywords        String? @db.Text
  canonicalUrl    String? @db.VarChar(255)
  ogTitle         String? @db.VarChar(255)
  ogDescription   String? @db.Text
  ogImage         String? @db.VarChar(255)
  robots          String? @default("index, follow") @db.VarChar(50)
  structuredData  String? @db.LongText
  articleId       String  @unique
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("article_seo")
}

model BrandClient {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  country      String
  logo         String
  logoId       String
  websiteUrl   String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_clients")
}

model Portfolio {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  clientName      String
  description     String?        @db.Text
  image           String
  imageId         String
  displayOrder    Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  eventCategory   EventCategory? @relation(fields: [eventCategoryId], references: [id])
  eventCategoryId String?

  @@index([eventCategoryId])
  @@map("portfolios")
}

model EventCategory {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  orderCount   Int         @default(0)
  image        String
  imageId      String
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  portfolios   Portfolio[]

  @@map("event_categories")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(50)
  interest  String?  @db.VarChar(100)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@map("contact_messages")
}

model HeroBannerProduct {
  id            String   @id @default(uuid())
  title         String?  @db.Text
  subtitle      String?  @db.Text
  imageUrl      String
  imagePublicId String?
  linkUrl       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("hero_banners")
}
